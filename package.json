{
  "name": "rntwsc",
  "version": "0.0.0-locked",
  "author": "Nam Nguyen <nam@namnm.com>",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "fmt": "node ./devtools css-extract-variables,sync-create-rntwsc-app-templates,normalize,doctoc,eslint,stylelint,prettier",
    "normalize": "node ./devtools normalize",
    "doctoc": "node ./devtools doctoc",
    "eslint": "node ./devtools eslint",
    "stylelint": "node ./devtools stylelint",
    "prettier": "node ./devtools prettier",
    "ts": "node ./devtools tsc,type-coverage",
    "tsc": "node ./devtools tsc",
    "type-coverage": "node ./devtools type-coverage",
    "test": "vitest run",
    "testw": "vitest",
    "dist": "node ./devtools build-dist",
    "cli": "node ./devtools build-cli",
    "extract": "node ./devtools css-extract-variables",
    "sync": "node ./devtools sync-create-rntwsc-app-templates"
  },
  "engines": {
    "node": ">=24.11",
    "pnpm": ">=11"
  },
  "dependencies": {
    "rntwsc": "github:namnm/rntwsc#d903c25701062e5f393d5d8e3c4a1e56e2b418b9"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "dist": {
    "version": "0.0.10"
  }
}
