{
  "name": "rntwsc",
  "version": "0.0.0-locked",
  "author": "Nam Nguyen <nam@namnm.com>",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "fmt": "node ./devtools css-extract-variables,extract-tw-class-names,sync-create-rntwsc-app-templates,normalize,doctoc,eslint,stylelint,prettier",
