{
  "name": "react-native-tailwind-nextjs",
  "version": "0.0.0-locked",
  "author": "Nam Nguyen <nam@namnm.com>",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "fmt": "node ./devtools fmt",
    "doctoc": "node ./devtools doctoc",
    "normalize": "node ./devtools normalize",
    "eslint": "node ./devtools eslint",
    "stylelint": "node ./devtools stylelint",
    "prettier": "node ./devtools prettier",
    "ts": "node ./devtools ts",
    "tsc": "node ./devtools tsc",
    "type-coverage": "node ./devtools type-coverage",
    "dev": "cd apps/playground/web && pnpm start"
  },
  "engines": {
    "node": ">=24.11",
    "pnpm": ">=11"
  },
  "dependencies": {
    "json5": "2.2.3",
    "tsconfig-paths": "4.2.0"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "typescript": "6.0.3"
  },
  "ignoreTsc": true
}
