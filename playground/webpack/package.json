    "start2": "cross-env NEXT_PUBLIC_MINIFY_CLASS_NAMES=1 next dev --webpack",
    "build2": "cross-env NEXT_PUBLIC_MINIFY_CLASS_NAMES=1 next build --webpack"
  },
  "engines": {
    "node": ">=24.11",
    "pnpm": ">=11"
  },
  "dependencies": {
    "next": "16.2.12",
    "react-dom": "19.2.3",
    "react-native-svg-web": "1.0.9",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.4",
    "baseline-browser-mapping": "latest",
    "cross-env": "10.1.0",
    "postcss-rename": "0.8.1",
    "shx": "0.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1"
  }
