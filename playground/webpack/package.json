{
  "name": "@rntwsc/playground-webpack",
  "version": "0.0.0-locked",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "copy": "shx rm -rf ./src && shx cp -r ../turbopack/src ./src",
    "start": "next dev --webpack",
